# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Copy to .env.local for local dev. For GitHub Pages, add the same four values as
# repository Variables (Settings → Secrets and variables → Actions → Variables).
# Leave them empty to run the app without accounts (data stays on the device).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
